# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# editor — share settings and recommendations only
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-intl generated ICU argument types, beside each English catalog
**/messages/*.d.json.ts

# StyleX vars generated from Tokens Studio JSON
tokens/generated/

# skills
.wayfinder

# lefthook local overrides
lefthook-local.yml
.lefthook-local.yml

*storybook.log
storybook-static
