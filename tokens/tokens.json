{
  "primitive": {
    "color": {
      "black": {
        "$type": "color",
        "$value": "oklch(0 0 0)"
      },
      "night": {
        "$type": "color",
        "$value": "oklch(0.19 0.025 230)"
      },
      "ink": {
        "$type": "color",
        "$value": "oklch(0.18 0 0)"
      },
      "coral": {
        "$type": "color",
        "$value": "oklch(0.68 0.18 27)"
      },
      "flare": {
        "$type": "color",
        "$value": "oklch(0.68 0.26 27)"
      },
      "cyan": {
        "$type": "color",
        "$value": "oklch(0.78 0.20 215)"
      },
      "frost": {
        "$type": "color",
        "$value": "oklch(0.95 0.008 230)"
      },
      "fog": {
        "$type": "color",
        "$value": "oklch(1 0 0 / 0.12)"
      },
      "white": {
        "$type": "color",
        "$value": "oklch(1 0 0)"
      }
    },
    "font": {
      "mono": {
        "$type": "fontFamily",
        "$value": "var(--font-mono, ui-monospace), monospace"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "var(--font-sans, system-ui), sans-serif"
      }
    },
    "grid": {
      "goldenRatio": {
        "$type": "number",
        "$value": 1.618
      },
      "module": {
        "$type": "dimension",
        "$value": "0.25rem"
      }
    },
    "viewport": {
      "phone-small": {
        "$description": "Phone SM",
        "width": {
          "$type": "dimension",
          "$value": "320px"
        },
        "height": {
          "$type": "dimension",
          "$value": "568px"
        }
      },
      "phone": {
        "$description": "Phone MD",
        "width": {
          "$type": "dimension",
          "$value": "390px"
        },
        "height": {
          "$type": "dimension",
          "$value": "844px"
        }
      },
      "tablet-portrait": {
        "$description": "Tablet Portrait",
        "width": {
          "$type": "dimension",
          "$value": "768px"
        },
        "height": {
          "$type": "dimension",
          "$value": "1024px"
        }
      },
      "laptop": {
        "$description": "Laptop",
        "width": {
          "$type": "dimension",
          "$value": "1280px"
        },
        "height": {
          "$type": "dimension",
          "$value": "800px"
        }
      },
      "desktop": {
        "$description": "Desktop",
        "width": {
          "$type": "dimension",
          "$value": "1920px"
        },
        "height": {
          "$type": "dimension",
          "$value": "1080px"
        }
      },
      "qhd": {
        "$description": "2K",
        "width": {
          "$type": "dimension",
          "$value": "2560px"
        },
        "height": {
          "$type": "dimension",
          "$value": "1440px"
        }
      },
      "four-k": {
        "$description": "4K",
        "width": {
          "$type": "dimension",
          "$value": "3840px"
        },
        "height": {
          "$type": "dimension",
          "$value": "2160px"
        }
      }
    },
    "motion": {
      "duration": {
        "none": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 0
          }
        },
        "fade": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 150
          }
        },
        "move": {
          "$type": "duration",
          "$value": {
            "unit": "ms",
            "value": 250
          }
        },
        "breathe": {
          "$type": "duration",
          "$value": {
            "unit": "s",
            "value": 12
          }
        }
      },
      "easing": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 0.2, 1]
        }
      }
    },
    "space": {
      "px": {
        "$type": "dimension",
        "$value": "1px"
      },
      "xxs": {
        "$type": "dimension",
        "$value": "{grid.module} * 0.5"
      },
      "xs": {
        "$type": "dimension",
        "$value": "{grid.module}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{grid.module} * 2"
      },
      "md": {
        "$type": "dimension",
        "$value": "{grid.module} * 4"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{grid.module} * 8"
      }
    }
  },
  "light": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.frost}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.ink}"
      }
    }
  },
  "dark": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.night}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.frost}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.coral}"
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "disabled",
        "light": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "primitive": "enabled",
        "dark": "enabled",
        "light": "disabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": ["primitive", "light", "dark"]
  }
}
