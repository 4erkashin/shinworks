# Set to 0 to turn off the browser Mock Service Worker.
# Unset leaves it on in pnpm dev.
# NEXT_PUBLIC_MSW=0

# App only. Public origin for metadataBase (social image URLs).
# Unset: http://localhost:3000, or https://${VERCEL_URL} on Vercel.
# Set on the app project to the canonical app origin once that
# domain exists.
# SITE_URL=https://example.com

# Storybook build only. Origin the OG-image story loads from.
# Unset: http://localhost:3000.
# Set on the Storybook project to the same app origin as SITE_URL.
# STORYBOOK_OG_BASE_URL=https://example.com

# App only. Home tile, read in lib/environment.ts.
# Unset: https://github.com/4erkashin/shinworks.
# GITHUB_URL=https://github.com/4erkashin/shinworks

# App only. Home tile, read in lib/environment.ts.
# Unset: http://localhost:6006 in development,
# and https://storybook.shinworks.dev/ in production.
# STORYBOOK_URL=https://storybook.shinworks.dev/

# App only. Home tile, read in lib/environment.ts.
# The address only. The tile adds mailto:.
# Unset: cherkashin.ju@gmail.com.
# CONTACT_EMAIL=cherkashin.ju@gmail.com
