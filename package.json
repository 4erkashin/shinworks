{
  "name": "shinworks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm tokens:build && concurrently --kill-others --names tokens,next \"pnpm tokens:watch\" \"next dev\"",
    "build": "pnpm tokens:build && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "node tokens/build.js",
    "tokens:watch": "node tokens/watch.js",
    "typecheck": "pnpm tokens:build && node scripts/write-message-declarations.ts && tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "storybook": "pnpm tokens:build && concurrently --kill-others-on-fail --names tokens,next,storybook \"pnpm tokens:watch\" \"if curl -fsS http://localhost:3000 >/dev/null; then echo 'Using existing Next.js server on port 3000'; else next dev; fi\" \"until curl -fsS http://localhost:3000 >/dev/null; do sleep 1; done; storybook dev -p 6006\"",
    "build-storybook": "pnpm tokens:build && storybook build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "clsx": "2.1.1",
    "motion": "13.2.0",
    "next": "16.3.3",
    "next-intl": "4.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/postcss-plugin": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@svgr/webpack": "8.1.0",
    "@tanstack/eslint-plugin-query": "5.102.8",
    "@tokens-studio/sd-transforms": "2.0.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-storybook": "10.5.10",
    "lefthook": "2.1.10",
    "modern-normalize": "3.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "storybook": "10.5.10",
    "storybook-next-intl": "10.1.3",
    "style-dictionary": "5.5.2",
    "typescript": "5.9.3",
    "unplugin": "2.3.11",
    "vite": "8.2.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
